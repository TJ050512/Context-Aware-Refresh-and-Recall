  "methods": [
    {"id": "never", "policy": "bootstrap_only"},
    {"id": "always", "policy": "publish_every_eligible_window"},
    {"id": "period_20", "policy": "fixed_period", "steps": 20},
    {"id": "period_50", "policy": "fixed_period", "steps": 50},
    {"id": "period_100", "policy": "fixed_period", "steps": 100},
    {"id": "oracle_shift", "policy": "publish_at_true_shift", "diagnostic_only": true}
