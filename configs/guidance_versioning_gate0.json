    "guide_path_build_event_sentinel",
    "zero_vertex_and_edge_swap_collisions"
  ],
  "primary_endpoints": [
    "total_throughput",
    "post_shift_throughput",
    "recovery_time",
    "publication_count",
    "cohort_service_time",
    "generator_seconds",
    "planner_seconds",
    "total_wall_clock_seconds"
  ],
  "gate": {
    "required_ordering": "at least one non-oracle dynamic schedule significantly beats never and leaves headroom relative to always or oracle_shift",
    "static_degradation_max_fraction": 0.02,
    "safety_violations_allowed": 0
