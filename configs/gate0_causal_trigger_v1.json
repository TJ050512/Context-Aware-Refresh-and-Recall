{
  "schema": "dai.gate0.causal-trigger-config/v1",
  "claim_scope": "Diagnostic causal-trigger bring-up only. The next-route-flow candidate generator consumes true Kiva distribution weights; no deployable, OnlineGGO, or SOTA claim is permitted.",
  "protocol": {
    "development_seeds": [20, 21, 22, 23, 24, 25, 26],
    "evaluation_seeds": [101, 102, 103, 104, 105, 106, 107, 108, 109, 110],
    "locked_test_seeds": [1001, 1002, 1003, 1004, 1005, 1006, 1007, 1008, 1009, 1010, 1011, 1012, 1013, 1014, 1015, 1016, 1017, 1018, 1019, 1020, 1021, 1022, 1023, 1024, 1025, 1026, 1027, 1028, 1029, 1030],
    "shift_count": 3,
    "label_horizon_steps": 160,
    "publication_penalty_tasks": 1.0,
    "development_methods": [
      "never",
      "shiftmask_001",
      "shiftmask_010",
      "shiftmask_011",
      "shiftmask_100",
      "shiftmask_101",
      "shiftmask_110",
      "shiftmask_111"
    ]
  },
  "experiment": {
    "agents": 400,
    "warmup_time": 40,
    "horizon": 600,
    "decision_window": 20,
    "shift_interval": 160,
    "generator_mode": "next_route_flow",
    "flow_bias": 0.1
  },
  "feature_names": [
    "guidance_age_windows",
    "task_js_since_refresh",
    "task_entropy",
    "task_hotspot",
    "recent_completed_per_agent",
    "recent_route_builds_per_agent",
    "recent_wait_ratio",
    "opposite_flow_ratio",
    "candidate_l1_relative",
    "candidate_cosine_distance"
  ],
  "model": {
    "family": "standardized_ridge_local_net_value",
    "candidate_lambdas": [0.1, 1.0, 10.0, 100.0, 1000.0],
    "selection": "leave-one-development-seed-out mean squared error",
    "beta": 1.0,
    "threshold": 0.0,
    "reported_rules": ["oracle_boundary_ridge", "oracle_boundary_lcb"],
    "deployment_rule": "oracle_boundary_lcb"
  }
}
