# OnlineGGO is reconstructed from the pinned upstream revision and local patch.
external/OnlineGGO/

# Raw experiment traces are too large for ordinary Git. Keep compact tables,
# summaries, and frozen analyses; publish full raw archives separately.
results/**/*.json
results/**/*.jsonl
!results/**/*analysis*.json
!results/**/summary.json
!results/**/ASSESSMENT.json
!results/**/ARTIFACT_SHA256.json
!results/**/online_ggo_preflight*.json
!results/**/autodl_environment_manifest.json

# Native experiment binaries are regenerated for each target platform.
results/**/*.so
results/**/*.dylib
