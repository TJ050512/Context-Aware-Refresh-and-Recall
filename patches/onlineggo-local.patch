+py::dict generate_kiva_saturated_goal_tape(
+    const std::string& map_path,
+    int num_agents,
+    int goals_per_agent,
+    std::uint32_t episode_seed
+){
+    if (num_agents <= 0){
+        throw std::invalid_argument("num_agents must be positive");
+    }
+    if (goals_per_agent <= 0){
+        throw std::invalid_argument("goals_per_agent must be positive");
+    }
+
+    Grid tape_grid;
+    tape_grid.load_from_path(map_path);
+    if (tape_grid.agent_home_locs.empty() || tape_grid.end_points.empty()){
+        throw std::invalid_argument(
+            "saturated Kiva goal tapes require W and E locations"
+        );
+    }
+    if (num_agents > static_cast<int>(tape_grid.empty_locs.size())){
+        throw std::invalid_argument(
+            "num_agents exceeds the number of traversable start locations"
+        );
+    }
+
+    const std::uint32_t start_seed = dai_derive_seed(episode_seed, 1);
+    const std::uint32_t task_seed = dai_derive_seed(episode_seed, 2);
+    std::mt19937 start_rng(start_seed);
+    std::shuffle(
+        tape_grid.empty_locs.begin(), tape_grid.empty_locs.end(), start_rng
+    );
+
+    std::vector<int> starts(
+        tape_grid.empty_locs.begin(),
+        tape_grid.empty_locs.begin() + num_agents
+    );
+    std::vector<std::vector<int>> goal_tape(
+        num_agents, std::vector<int>()
+    );
+    const std::vector<double> endpoint_weights(
+        tape_grid.end_points.size(), 1.0
+    );
+    std::discrete_distribution<int> home_distribution(
+        tape_grid.agent_home_loc_weights.begin(),
+        tape_grid.agent_home_loc_weights.end()
+    );
+    std::discrete_distribution<int> endpoint_distribution(
+        endpoint_weights.begin(), endpoint_weights.end()
+    );
+
+    for (int agent_id = 0; agent_id < num_agents; ++agent_id){
+        std::mt19937 task_rng(dai_derive_seed(
+            task_seed, static_cast<std::uint64_t>(agent_id)
+        ));
+        goal_tape[agent_id].reserve(goals_per_agent);
+        int previous_location = starts[agent_id];
+        for (int tape_index = 0; tape_index < goals_per_agent; ++tape_index){
+            const char previous_type = tape_grid.grid_types[previous_location];
+            int goal_location;
+            if (previous_type == 'W'){
+                goal_location = tape_grid.end_points[
+                    endpoint_distribution(task_rng)
+                ];
+            } else if (previous_type == '.' || previous_type == 'E'){
+                goal_location = tape_grid.agent_home_locs[
+                    home_distribution(task_rng)
+                ];
+            } else {
+                throw std::runtime_error(
+                    "generated Kiva start/goal has an unsupported grid type"
+                );
+            }
+            goal_tape[agent_id].push_back(goal_location);
+            previous_location = goal_location;
+        }
+    }
+
+    py::dict result;
+    result["schema_version"] = "dai.saturated-goal-tape-generator/v1";
+    result["workload"] = "uniform_kiva_saturated_backlog";
+    result["episode_seed"] = episode_seed;
+    result["start_seed"] = start_seed;
+    result["task_seed"] = task_seed;
+    result["num_agents"] = num_agents;
+    result["goals_per_agent"] = goals_per_agent;
+    result["start_locations"] = starts;
+    result["goal_tape"] = goal_tape;
+    result["content_fnv1a64"] = dai_fixed_goal_tape_fnv1a64(
+        starts, goal_tape
+    );
+    return result;
+}
