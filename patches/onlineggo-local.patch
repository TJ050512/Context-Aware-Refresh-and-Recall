+def _dai_fixed_goal_tape_fnv1a64(start_locations, goal_tape):
+    digest = 14695981039346656037
+
+    def add_byte(value):
+        nonlocal digest
+        digest ^= value
+        digest = (digest * 1099511628211) & _UINT64_MASK
+
+    def add_uint64(value):
+        for byte_index in range(8):
+            add_byte((int(value) >> (8 * byte_index)) & 0xff)
+
+    for byte in DAI_TASK_TAPE_SCHEMA_VERSION.encode("ascii"):
+        add_byte(byte)
+    add_uint64(len(goal_tape))
+    for agent_id, sequence in enumerate(goal_tape):
+        add_uint64(agent_id)
+        add_uint64(start_locations[agent_id])
+        add_uint64(len(sequence))
+        for goal_location in sequence:
+            add_uint64(goal_location)
+    return f"{digest:016x}"
