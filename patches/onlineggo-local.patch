+bool dai_is_lower_sha256(const std::string& digest){
+    if (digest.size() != 64){
+        return false;
+    }
+    return std::all_of(
+        digest.begin(), digest.end(),
+        [](const char character){
+            return (character >= '0' && character <= '9')
+                || (character >= 'a' && character <= 'f');
+        }
+    );
+}
