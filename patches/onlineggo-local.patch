+                    raise ValueError(
+                        "DAI released event does not occur at its absolute time"
+                    )
+                reconstructed_released[agent_id] += 1
+            elif event["event_type"] == "assigned":
+                tape_index = reconstructed_assigned[agent_id]
+                if tape_index >= reconstructed_released[agent_id]:
+                    raise ValueError("DAI task event assigns an unreleased task")
+                if event["timestep"] < self._dai_expected_absolute_task_tape[
+                    agent_id
+                ][tape_index][1]:
