+def _dai_fixed_goal_tape_sha256(start_locations, goal_tape):
+    canonical = json.dumps(
+        {
+            "schema_version": DAI_TASK_TAPE_SCHEMA_VERSION,
+            "start_locations": start_locations,
+            "goal_tape": goal_tape,
+        },
