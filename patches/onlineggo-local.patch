+constexpr std::uint64_t DAI_FNV1A64_OFFSET = 14695981039346656037ULL;
+constexpr std::uint64_t DAI_FNV1A64_PRIME = 1099511628211ULL;
+
+void dai_fnv1a64_add_byte(std::uint64_t& digest, std::uint8_t value){
+    digest ^= static_cast<std::uint64_t>(value);
+    digest *= DAI_FNV1A64_PRIME;
+}
+
+void dai_fnv1a64_add_uint64(std::uint64_t& digest, std::uint64_t value){
+    // The canonical tape encoding is explicitly little-endian and therefore
+    // independent of the host architecture.
+    for (int byte_index = 0; byte_index < 8; ++byte_index){
+        dai_fnv1a64_add_byte(
+            digest,
+            static_cast<std::uint8_t>((value >> (8 * byte_index)) & 0xffU)
+        );
+    }
+}
+
+std::string dai_fixed_goal_tape_fnv1a64_impl(
+    const std::vector<int>& start_locations,
+    const std::vector<std::vector<int>>& goal_tape
+){
+    std::uint64_t digest = DAI_FNV1A64_OFFSET;
+    const std::string schema = "dai.saturated-goal-tape/v1";
+    for (const unsigned char character: schema){
+        dai_fnv1a64_add_byte(digest, character);
+    }
+    dai_fnv1a64_add_uint64(
+        digest, static_cast<std::uint64_t>(goal_tape.size())
+    );
+    for (std::size_t agent_id = 0; agent_id < goal_tape.size(); ++agent_id){
+        dai_fnv1a64_add_uint64(
+            digest, static_cast<std::uint64_t>(agent_id)
+        );
+        dai_fnv1a64_add_uint64(
+            digest,
+            static_cast<std::uint64_t>(
+                static_cast<std::int64_t>(start_locations[agent_id])
+            )
+        );
+        dai_fnv1a64_add_uint64(
+            digest, static_cast<std::uint64_t>(goal_tape[agent_id].size())
+        );
+        for (const int goal_location: goal_tape[agent_id]){
+            dai_fnv1a64_add_uint64(
+                digest,
+                static_cast<std::uint64_t>(
+                    static_cast<std::int64_t>(goal_location)
+                )
+            );
+        }
+    }
+    std::ostringstream encoded;
+    encoded << std::hex << std::setfill('0') << std::setw(16) << digest;
+    return encoded.str();
+}
+
+std::string dai_absolute_task_tape_fnv1a64_impl(
+    const std::vector<int>& start_locations,
+    const std::vector<std::vector<std::vector<int>>>& task_tape
+){
+    std::uint64_t digest = DAI_FNV1A64_OFFSET;
+    const std::string schema = "dai.kiva-absolute-release-tape/v1";
+    for (const unsigned char character: schema){
+        dai_fnv1a64_add_byte(digest, character);
+    }
+    dai_fnv1a64_add_uint64(
+        digest, static_cast<std::uint64_t>(task_tape.size())
+    );
+    for (std::size_t agent_id = 0; agent_id < task_tape.size(); ++agent_id){
+        dai_fnv1a64_add_uint64(digest, agent_id);
+        dai_fnv1a64_add_uint64(
+            digest,
+            static_cast<std::uint64_t>(
+                static_cast<std::int64_t>(start_locations[agent_id])
+            )
+        );
+        dai_fnv1a64_add_uint64(digest, task_tape[agent_id].size());
+        for (const auto& entry: task_tape[agent_id]){
+            if (entry.size() != 2){
+                throw std::invalid_argument(
+                    "absolute task entries must be [goal, release_timestep]"
+                );
+            }
+            dai_fnv1a64_add_uint64(
+                digest,
+                static_cast<std::uint64_t>(
+                    static_cast<std::int64_t>(entry[0])
+                )
+            );
+            dai_fnv1a64_add_uint64(
+                digest,
+                static_cast<std::uint64_t>(
+                    static_cast<std::int64_t>(entry[1])
+                )
+            );
+        }
+    }
+    std::ostringstream encoded;
+    encoded << std::hex << std::setfill('0') << std::setw(16) << digest;
+    return encoded.str();
+}
