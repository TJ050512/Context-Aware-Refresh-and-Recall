+def _normalize_dai_fixed_goal_tape(goal_tape, *, num_agents, map_size):
+    """Return a defensive, integer-only copy of a per-agent goal tape."""
+    if goal_tape is None:
+        return None
+    if isinstance(goal_tape, (str, bytes)):
+        raise TypeError("fixed_goal_tape must be a nested sequence")
+    try:
+        agent_sequences = list(goal_tape)
+    except TypeError as exc:
+        raise TypeError("fixed_goal_tape must be a nested sequence") from exc
+    if len(agent_sequences) != num_agents:
+        raise ValueError(
+            "fixed_goal_tape must contain exactly one sequence per agent"
+        )
+    normalized = []
+    for agent_id, sequence in enumerate(agent_sequences):
+        if isinstance(sequence, (str, bytes)):
+            raise TypeError(
+                f"fixed_goal_tape[{agent_id}] must be a goal sequence"
+            )
+        try:
+            goals = list(sequence)
+        except TypeError as exc:
+            raise TypeError(
+                f"fixed_goal_tape[{agent_id}] must be a goal sequence"
+            ) from exc
+        if not goals:
+            raise ValueError("fixed goal tape sequences must be non-empty")
+        normalized_goals = []
+        for tape_index, goal in enumerate(goals):
+            if isinstance(goal, (bool, np.bool_)) or not isinstance(
+                goal, (int, np.integer)
+            ):
+                raise TypeError(
+                    "fixed goal locations must be flattened integer map IDs; "
+                    f"received {goal!r} for agent {agent_id}, index {tape_index}"
+                )
+            goal = int(goal)
+            if goal < 0 or goal >= map_size:
+                raise ValueError(
+                    f"fixed goal location {goal} is outside the flattened map"
+                )
+            normalized_goals.append(goal)
+        normalized.append(normalized_goals)
+    return normalized
+
