+
+        if reconstructed_released != released_prefix:
+            raise ValueError(
+                "DAI released events do not reconstruct the reported prefixes"
+            )
+        if reconstructed_assigned != assigned_prefix:
+            raise ValueError(
+                "DAI assigned events do not reconstruct the reported prefixes"
+            )
+        if reconstructed_completed != completed_prefix:
+            raise ValueError(
+                "DAI finished events do not reconstruct the reported prefixes"
+            )
+        self._dai_last_tape_released_prefix = list(released_prefix)
+        self._dai_last_tape_assigned_prefix = list(assigned_prefix)
+        self._dai_last_tape_completed_prefix = list(completed_prefix)
+        self._dai_absolute_assignment_timestamps = assignment_timestamps
+        self._dai_current_absolute_completed_prefix = list(completed_prefix)
