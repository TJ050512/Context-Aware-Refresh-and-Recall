+void KivaSystem::configure_absolute_task_tape(
+    const std::vector<int>& expected_start_locations,
+    const std::vector<std::vector<std::vector<int>>>& task_tape,
+    const std::string& manifest_sha256
+){
+    if (!assigned_tasks.empty() || !all_tasks.empty()){
+        throw std::logic_error(
+            "absolute task tape must be configured before initialization"
+        );
+    }
+    if (fixed_goal_tape_enabled){
+        throw std::logic_error(
+            "absolute and saturated fixed task tapes are mutually exclusive"
+        );
+    }
+    if (!dai_is_lower_sha256(manifest_sha256)){
+        throw std::invalid_argument(
+            "absolute task-tape manifest sha256 must be lowercase hex"
+        );
+    }
+    if (task_tape.size() != static_cast<std::size_t>(num_of_agents)){
+        throw std::invalid_argument(
+            "absolute task tape must contain one sequence per agent"
+        );
+    }
+    if (
+        expected_start_locations.size()
+        != static_cast<std::size_t>(num_of_agents)
+    ){
+        throw std::invalid_argument(
+            "absolute task-tape manifest must contain one start per agent"
+        );
+    }
+    for (int agent_id = 0; agent_id < num_of_agents; ++agent_id){
+        if (expected_start_locations[agent_id] != starts[agent_id].location){
+            throw std::invalid_argument(
+                "absolute task-tape starts disagree with the simulator seed"
+            );
+        }
+    }
+
+    std::uint64_t total_tasks = 0;
+    std::vector<std::uint64_t> tape_lengths;
+    std::vector<std::deque<DAIAbsoluteTask>> unreleased(num_of_agents);
+    tape_lengths.reserve(num_of_agents);
+    int next_task_id = 0;
+    for (int agent_id = 0; agent_id < num_of_agents; ++agent_id){
+        const auto& sequence = task_tape[agent_id];
+        if (sequence.empty()){
+            throw std::invalid_argument(
+                "absolute task-tape sequences must be non-empty"
+            );
+        }
+        if (
+            sequence.size()
+            > static_cast<std::size_t>(
+                std::numeric_limits<int>::max() - next_task_id
+            )
+        ){
+            throw std::overflow_error(
+                "absolute task tape exceeds the int task-id range"
+            );
+        }
+        int previous_location = starts[agent_id].location;
+        int previous_release = -1;
+        for (const auto& entry: sequence){
+            if (entry.size() != 2){
+                throw std::invalid_argument(
+                    "absolute task entries must be [goal, release_timestep]"
+                );
+            }
+            const int goal_location = entry[0];
+            const int release_timestep = entry[1];
+            if (release_timestep < 0 || release_timestep < previous_release){
+                throw std::invalid_argument(
+                    "absolute release timesteps must be non-negative and "
+                    "nondecreasing per agent"
+                );
+            }
+            if (
+                goal_location < 0
+                || goal_location >= static_cast<int>(map.map.size())
+                || map.map[goal_location] != 0
+            ){
+                throw std::invalid_argument(
+                    "absolute task tape contains an invalid goal"
+                );
+            }
+            const char previous_type = map.grid_types[previous_location];
+            bool valid_kiva_transition = false;
+            if (previous_type == 'W'){
+                valid_kiva_transition = dai_contains_location(
+                    map.end_points, goal_location
+                );
+            } else if (previous_type == '.' || previous_type == 'E'){
+                valid_kiva_transition = dai_contains_location(
+                    map.agent_home_locs, goal_location
+                );
+            }
+            if (!valid_kiva_transition){
+                throw std::invalid_argument(
+                    "absolute task tape violates Kiva W/endpoint alternation"
+                );
+            }
+            unreleased[agent_id].emplace_back(
+                Task(next_task_id++, goal_location, -1, agent_id),
+                release_timestep
+            );
+            previous_location = goal_location;
+            previous_release = release_timestep;
+        }
+        tape_lengths.push_back(sequence.size());
+        total_tasks += sequence.size();
+    }
+
+    absolute_task_unreleased_queues = std::move(unreleased);
+    absolute_task_released_backlogs.clear();
+    absolute_task_released_backlogs.resize(num_of_agents);
+    absolute_task_tape_enabled = true;
+    absolute_task_tape_manifest_sha256 = manifest_sha256;
+    absolute_task_tape_content_fnv1a64 = dai_absolute_task_tape_fnv1a64(
+        expected_start_locations, task_tape
+    );
+    absolute_task_tape_start_locations = expected_start_locations;
+    absolute_task_tape_lengths = std::move(tape_lengths);
+    absolute_task_tape_released_prefix.assign(num_of_agents, 0);
+    absolute_task_tape_assigned_prefix.assign(num_of_agents, 0);
+    absolute_task_tape_total_tasks = total_tasks;
+}
