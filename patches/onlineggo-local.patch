+void KivaSystem::configure_fixed_goal_tape(
+    const std::vector<int>& expected_start_locations,
+    const std::vector<std::vector<int>>& goal_tape,
+    const std::string& manifest_sha256
+){
+    if (!assigned_tasks.empty() || !all_tasks.empty()){
+        throw std::logic_error(
+            "fixed goal tape must be configured before simulator initialization"
+        );
+    }
+    if (!dai_is_lower_sha256(manifest_sha256)){
+        throw std::invalid_argument(
+            "fixed goal tape manifest sha256 must be 64 lowercase hex characters"
+        );
+    }
+    if (goal_tape.size() != static_cast<std::size_t>(num_of_agents)){
+        throw std::invalid_argument(
+            "fixed goal tape must contain exactly one sequence per agent"
+        );
+    }
+    if (
+        expected_start_locations.size()
+        != static_cast<std::size_t>(num_of_agents)
+    ){
+        throw std::invalid_argument(
+            "fixed goal tape manifest must contain one start per agent"
+        );
+    }
+    for (int agent_id = 0; agent_id < num_of_agents; ++agent_id){
+        if (expected_start_locations[agent_id] != starts[agent_id].location){
+            throw std::invalid_argument(
+                "fixed goal tape start locations disagree with the simulator seed"
+            );
+        }
+    }
+
+    std::uint64_t total_tasks = 0;
+    std::vector<std::uint64_t> tape_lengths;
+    std::vector<std::deque<Task>> task_queues(num_of_agents);
+    tape_lengths.reserve(num_of_agents);
+
+    int next_task_id = 0;
+    for (int agent_id = 0; agent_id < num_of_agents; ++agent_id){
+        const auto& agent_tape = goal_tape[agent_id];
+        if (agent_tape.empty()){
+            throw std::invalid_argument(
+                "fixed goal tape sequences must be non-empty"
+            );
+        }
+        if (
+            agent_tape.size()
+            > static_cast<std::size_t>(
+                std::numeric_limits<int>::max() - next_task_id
+            )
+        ){
+            throw std::overflow_error(
+                "fixed goal tape has more tasks than the int task-id range"
+            );
+        }
+
+        int previous_location = starts[agent_id].location;
+        for (const int goal_location: agent_tape){
+            if (
+                goal_location < 0
+                || goal_location >= static_cast<int>(map.map.size())
+                || map.map[goal_location] != 0
+            ){
+                throw std::invalid_argument(
+                    "fixed goal tape contains an invalid or blocked location"
+                );
+            }
+
+            const char previous_type = map.grid_types[previous_location];
+            bool valid_kiva_transition = false;
+            if (previous_type == 'W'){
+                valid_kiva_transition = dai_contains_location(
+                    map.end_points, goal_location
+                );
+            } else if (previous_type == '.' || previous_type == 'E'){
+                valid_kiva_transition = dai_contains_location(
+                    map.agent_home_locs, goal_location
+                );
+            }
+            if (!valid_kiva_transition){
+                throw std::invalid_argument(
+                    "fixed goal tape violates Kiva W/endpoint alternation"
+                );
+            }
+
+            task_queues[agent_id].emplace_back(
+                next_task_id++, goal_location, 0, agent_id
+            );
+            previous_location = goal_location;
+        }
+        tape_lengths.push_back(
+            static_cast<std::uint64_t>(agent_tape.size())
+        );
+        total_tasks += static_cast<std::uint64_t>(agent_tape.size());
+    }
+
+    fixed_goal_task_queues = std::move(task_queues);
+    fixed_goal_tape_enabled = true;
+    fixed_goal_tape_exhausted = false;
+    fixed_goal_tape_manifest_sha256 = manifest_sha256;
+    fixed_goal_tape_content_fnv1a64 = dai_fixed_goal_tape_fnv1a64(
+        expected_start_locations, goal_tape
+    );
+    fixed_goal_tape_start_locations = expected_start_locations;
+    fixed_goal_tape_lengths = std::move(tape_lengths);
+    fixed_goal_tape_assigned_prefix.assign(num_of_agents, 0);
+    fixed_goal_tape_total_tasks = total_tasks;
+}
