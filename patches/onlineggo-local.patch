+void BaseSystem::capture_route_build_snapshot(){
+    pending_route_traj_was_empty.assign(num_of_agents, true);
+    pending_route_task_ids.assign(num_of_agents, -1);
+    pending_route_goal_locs.assign(num_of_agents, -1);
+    pending_route_planner_goal_locs.assign(num_of_agents, -1);
+    for (int i = 0; i < num_of_agents; ++i){
+        pending_route_traj_was_empty[i] = planner->trajLNS.trajs[i].empty();
+        pending_route_planner_goal_locs[i] = planner->trajLNS.tasks[i];
+        if (!assigned_tasks[i].empty()){
+            pending_route_task_ids[i] = assigned_tasks[i].front().task_id;
+            pending_route_goal_locs[i] = assigned_tasks[i].front().location;
+        }
+    }
+    pending_route_map_weights_revision = map_weights_revision;
+    pending_route_snapshot_valid = true;
+}
+
+void BaseSystem::record_route_builds_after_plan(const vector<Action>& actions){
+    if (!pending_route_snapshot_valid || actions.size() != num_of_agents){
+        pending_route_snapshot_valid = false;
+        return;
+    }
+    for (int i = 0; i < num_of_agents; ++i){
+        const bool is_nonempty = !planner->trajLNS.trajs[i].empty();
+        const bool initialized = pending_route_traj_was_empty[i] && is_nonempty;
+        const bool changed_task = planner->task_change[i] && is_nonempty;
+        const int task_id = pending_route_task_ids[i];
+        const bool first_task_exposure =
+            is_nonempty && task_id >= 0
+            && last_route_exposed_task_ids[i] != task_id;
+        if (initialized || changed_task){
+            last_route_plan_map_weights_revisions[i] =
+                pending_route_map_weights_revision;
+        }
+        if (task_id < 0){
+            continue;
+        }
+        long long exposure_revision = pending_route_map_weights_revision;
+        std::string reason = initialized ? "init_pp" : "task_change";
+        if (first_task_exposure && !initialized && !changed_task){
+            // An idle agent may already have a trajectory for a private
+            // holding goal that later becomes the next real task goal.  No
+            // new route was built in this plan, so inherit the revision that
+            // actually produced the reusable trajectory rather than falsely
+            // assigning the current revision.
+            if (
+                pending_route_planner_goal_locs[i]
+                    != pending_route_goal_locs[i]
+                || last_route_plan_map_weights_revisions[i] < 0
+            ){
+                throw std::logic_error(
+                    "new task has no auditable route-build provenance"
+                );
+            }
+            exposure_revision = last_route_plan_map_weights_revisions[i];
+            reason = "inherited_goal_route";
+        } else if (!initialized && !changed_task){
+            continue;
+        }
+        route_build_trace.push_back(make_tuple(
+            next_route_build_event_id++, i, task_id,
+            pending_route_goal_locs[i], timestep + 1,
+            exposure_revision, reason
+        ));
+        last_route_exposed_task_ids[i] = task_id;
+    }
+    pending_route_snapshot_valid = false;
+}
