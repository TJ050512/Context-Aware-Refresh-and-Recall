+def _normalize_dai_absolute_task_tape(
+    task_tape, *, num_agents, map_size, horizon_steps
+):
+    """Return a defensive copy of per-agent ``[goal, release]`` records."""
+    if task_tape is None:
+        return None
+    if isinstance(task_tape, (str, bytes)):
+        raise TypeError("absolute_task_tape must be a nested sequence")
+    try:
+        agent_sequences = list(task_tape)
+    except TypeError as exc:
+        raise TypeError("absolute_task_tape must be a nested sequence") from exc
+    if len(agent_sequences) != num_agents:
+        raise ValueError(
+            "absolute_task_tape must contain exactly one sequence per agent"
+        )
+    normalized = []
+    for agent_id, sequence in enumerate(agent_sequences):
+        if isinstance(sequence, (str, bytes)):
+            raise TypeError(
+                f"absolute_task_tape[{agent_id}] must be a task sequence"
+            )
+        try:
+            entries = list(sequence)
+        except TypeError as exc:
+            raise TypeError(
+                f"absolute_task_tape[{agent_id}] must be a task sequence"
+            ) from exc
+        if not entries:
+            raise ValueError("absolute task-tape sequences must be non-empty")
+        previous_release = -1
+        normalized_entries = []
+        for tape_index, entry in enumerate(entries):
+            if isinstance(entry, (str, bytes)):
+                raise TypeError("absolute task entries must be [goal, release]")
+            try:
+                values = list(entry)
+            except TypeError as exc:
+                raise TypeError(
+                    "absolute task entries must be [goal, release]"
+                ) from exc
+            if len(values) != 2:
+                raise ValueError("absolute task entries must be [goal, release]")
+            goal, release_timestep = values
+            if isinstance(goal, (bool, np.bool_)) or not isinstance(
+                goal, (int, np.integer)
+            ):
+                raise TypeError(
+                    "absolute goal locations must be flattened integers; "
+                    f"received {goal!r} for agent {agent_id}, index {tape_index}"
+                )
+            if isinstance(release_timestep, (bool, np.bool_)) or not isinstance(
+                release_timestep, (int, np.integer)
+            ):
+                raise TypeError("absolute release timesteps must be integers")
+            goal = int(goal)
+            release_timestep = int(release_timestep)
+            if goal < 0 or goal >= map_size:
+                raise ValueError(
+                    f"absolute goal location {goal} is outside the flattened map"
+                )
+            if release_timestep < 0 or release_timestep >= horizon_steps:
+                raise ValueError(
+                    f"release timestep {release_timestep} is outside "
+                    f"[0, {horizon_steps})"
+                )
+            if release_timestep < previous_release:
+                raise ValueError(
+                    "absolute release timesteps must be nondecreasing per agent"
+                )
+            normalized_entries.append([goal, release_timestep])
+            previous_release = release_timestep
+        normalized.append(normalized_entries)
+    return normalized
+
