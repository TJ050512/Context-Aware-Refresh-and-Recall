+    def _dai_validate_task_tape(self, task_tape, events, trace_end=None):
+        if not isinstance(task_tape, dict):
+            raise ValueError("DAI task-tape metadata must be an object")
+        if task_tape.get("schema_version") == DAI_ABSOLUTE_TASK_TAPE_SCHEMA_VERSION:
+            if trace_end is None:
+                raise ValueError("trace_end is required for an absolute task tape")
+            self._dai_validate_absolute_task_tape(task_tape, events, trace_end)
+            return
+        if getattr(self, "_dai_expected_absolute_task_tape", None) is not None:
+            raise RuntimeError(
+                "simulator did not enable the requested absolute task tape"
+            )
+        keys = {
+            "schema_version",
+            "enabled",
+            "mode",
+            "manifest_sha256",
+            "content_fnv1a64",
+            "start_locations",
+            "per_agent_lengths",
+            "assigned_prefix_lengths",
+            "completed_prefix_lengths",
+            "total_tasks",
+            "exhausted",
+            "task_id_semantics",
+            "fingerprint_semantics",
+        }
+        if not isinstance(task_tape, dict) or set(task_tape) != keys:
+            raise ValueError("DAI task-tape metadata has an invalid schema")
+        if task_tape["schema_version"] != DAI_TASK_TAPE_SCHEMA_VERSION:
+            raise ValueError("DAI task-tape schema version is unsupported")
+        if not isinstance(task_tape["enabled"], bool):
+            raise ValueError("DAI task-tape enabled marker must be boolean")
+        if not isinstance(task_tape["exhausted"], bool):
+            raise ValueError("DAI task-tape exhausted marker must be boolean")
+        if task_tape["task_id_semantics"] != DAI_TASK_TAPE_ID_SEMANTICS:
+            raise ValueError("DAI task-tape task-id semantics do not match v1")
+        if (
+            task_tape["fingerprint_semantics"]
+            != DAI_TASK_TAPE_FINGERPRINT_SEMANTICS
+        ):
+            raise ValueError("DAI task-tape fingerprint semantics do not match v1")
+
+        expected_enabled = self._dai_expected_goal_tape is not None
+        if task_tape["enabled"] != expected_enabled:
+            raise RuntimeError(
+                "C++ fixed-goal-tape mode disagrees with the Python manifest"
+            )
+        if not expected_enabled:
+            expected_online_metadata = {
+                "mode": "online_completion_driven_rng",
+                "manifest_sha256": "",
+                "content_fnv1a64": "",
+                "start_locations": [],
+                "per_agent_lengths": [],
+                "assigned_prefix_lengths": [],
+                "completed_prefix_lengths": [],
+                "total_tasks": 0,
+                "exhausted": False,
+            }
+            for field, expected in expected_online_metadata.items():
+                if task_tape[field] != expected:
+                    raise ValueError(
+                        f"disabled DAI task-tape field {field!r} is inconsistent"
+                    )
+            self._dai_last_tape_assigned_prefix = None
+            self._dai_last_tape_completed_prefix = None
+            self._dai_last_tape_released_prefix = None
+            if any(event["event_type"] == "released" for event in events):
+                raise ValueError(
+                    "online task generation cannot emit fixed-tape release events"
+                )
+            return
+
+        if task_tape["mode"] != "saturated_backlog_per_agent":
+            raise ValueError("enabled DAI task tape must use saturated backlog mode")
+        if task_tape["exhausted"]:
+            raise RuntimeError("fixed saturated goal tape was exhausted")
+        if task_tape["manifest_sha256"] != self._dai_expected_goal_tape_sha256:
+            raise RuntimeError("fixed goal tape manifest sha256 does not match")
+        if task_tape["content_fnv1a64"] != self._dai_expected_goal_tape_fnv1a64:
+            raise RuntimeError("C++ fixed goal tape content fingerprint does not match")
+        if (
+            task_tape["start_locations"]
+            != self._dai_expected_goal_tape_start_locations
+        ):
+            raise RuntimeError("C++ fixed goal tape starts do not match the manifest")
+
+        expected_lengths = [
+            len(sequence) for sequence in self._dai_expected_goal_tape
+        ]
+        if task_tape["per_agent_lengths"] != expected_lengths:
+            raise RuntimeError("C++ fixed goal tape lengths do not match the manifest")
+        if task_tape["total_tasks"] != sum(expected_lengths):
+            raise RuntimeError("C++ fixed goal tape total does not match the manifest")
+
+        assigned_prefix = task_tape["assigned_prefix_lengths"]
+        completed_prefix = task_tape["completed_prefix_lengths"]
+        for field, prefixes in (
+            ("assigned_prefix_lengths", assigned_prefix),
+            ("completed_prefix_lengths", completed_prefix),
+        ):
+            if (
+                not isinstance(prefixes, list)
+                or len(prefixes) != self.config.num_agents
+                or any(type(prefix) is not int or prefix < 0 for prefix in prefixes)
+            ):
+                raise ValueError(
+                    f"DAI task-tape {field} must contain one non-negative "
+                    "integer per agent"
+                )
+
+        previous_assigned = self._dai_last_tape_assigned_prefix
+        previous_completed = self._dai_last_tape_completed_prefix
+        if previous_assigned is None:
+            previous_assigned = [0] * self.config.num_agents
+            previous_completed = [0] * self.config.num_agents
+        if any(
+            not previous_assigned[agent_id] <= assigned_prefix[agent_id]
+            <= expected_lengths[agent_id]
+            for agent_id in range(self.config.num_agents)
+        ):
+            raise ValueError("DAI task-tape assigned prefixes are invalid or decreased")
+        if any(
+            not previous_completed[agent_id] <= completed_prefix[agent_id]
+            <= assigned_prefix[agent_id]
+            for agent_id in range(self.config.num_agents)
+        ):
+            raise ValueError("DAI task-tape completed prefixes are invalid or decreased")
+
+        offsets = []
+        running_offset = 0
+        for length in expected_lengths:
+            offsets.append(running_offset)
+            running_offset += length
+        reconstructed_assigned = list(previous_assigned)
+        reconstructed_completed = list(previous_completed)
+        for event in events:
+            agent_id = event["agent_id"]
+            if event["event_type"] == "assigned":
+                tape_index = reconstructed_assigned[agent_id]
+                if tape_index >= expected_lengths[agent_id]:
+                    raise ValueError("DAI task event assigns beyond the fixed tape")
+                reconstructed_assigned[agent_id] += 1
+            elif event["event_type"] == "finished":
+                tape_index = reconstructed_completed[agent_id]
+                if tape_index >= reconstructed_assigned[agent_id]:
+                    raise ValueError("DAI task event finishes an unassigned tape item")
+                reconstructed_completed[agent_id] += 1
+            else:
+                raise ValueError(
+                    "saturated goal tapes cannot emit released events"
+                )
+            expected_task_id = offsets[agent_id] + tape_index
+            expected_goal = self._dai_expected_goal_tape[agent_id][tape_index]
+            expected_goal_loc = [
+                expected_goal // self.comp_map.width,
+                expected_goal % self.comp_map.width,
+            ]
+            if event["task_id"] != expected_task_id:
+                raise ValueError(
+                    "DAI fixed-tape task_id does not match agent/tape index"
+                )
+            if event["goal_loc"] != expected_goal_loc:
+                raise ValueError("DAI fixed-tape event goal does not match the tape")
+
+        if reconstructed_assigned != assigned_prefix:
+            raise ValueError(
+                "DAI assigned events do not reconstruct the reported tape prefixes"
+            )
+        if reconstructed_completed != completed_prefix:
+            raise ValueError(
+                "DAI finished events do not reconstruct the reported tape prefixes"
+            )
+        self._dai_last_tape_assigned_prefix = list(assigned_prefix)
+        self._dai_last_tape_completed_prefix = list(completed_prefix)
+
