+def _dai_derive_seed(root_seed, stream_id):
+    """Mirror the simulator's versioned SplitMix64 stream derivation."""
+    value = (
+        int(root_seed)
+        + 0x9E3779B97F4A7C15 * (int(stream_id) + 1)
+    ) & _UINT64_MASK
+    value = (
+        (value ^ (value >> 30)) * 0xBF58476D1CE4E5B9
+    ) & _UINT64_MASK
+    value = (
+        (value ^ (value >> 27)) * 0x94D049BB133111EB
+    ) & _UINT64_MASK
+    value ^= value >> 31
+    return (value ^ (value >> 32)) & _UINT32_MAX
+
